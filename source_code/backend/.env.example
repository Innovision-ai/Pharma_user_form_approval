# Copy this file to .env and adjust as needed. All values below have sane
# defaults baked into the app, so running with no .env at all also works.

# SQLite file used by the app (relative to backend/)
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of origins allowed to call this API (your frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mailbox the "IT Provisioning Required" notification is addressed to.
# No real email is ever sent in this MVP - see services/notifications.py.
IT_NOTIFICATION_EMAIL=it.support@company.com

# --- Not used by the MVP yet - kept here as a placeholder for the Phase 2 ---
# --- "wire up real email delivery" roadmap item described in the client spec. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
